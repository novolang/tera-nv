// syntax_tests.nv — templates that do not parse.
//
// Generated by tools/syntax.py; do not edit by hand.  Each case is a
// template, the kind of error `parse` must answer and the line and
// column it must point at.  The position was marked in the source with
// `@@` and counted by the script.

use std.test
use std.str
use teraparse
use teracompile
use teraerror

// The error as text: its kind and what the kind carries.
fn describe(e: teraerror.TeraError) -> Str
    match e.kind
        ErrorSyntax(found)        => "syntax " + found
        ErrorUnclosed(tag)        => "unclosed " + tag
        ErrorUnexpectedTag(tag)   => "unexpected " + tag
        ErrorDuplicateBlock(name) => "duplicate " + name
        ErrorLimit(what)          => "limit " + what
        _                         => "other"

fn where_it_points(source: Str) -> Str
    match teraparse.parse("p.html", source)
        Ok(_)  => "parsed"
        Err(e) => describe(e) + "@" + str.from_int(e.at.line) + ":" + str.from_int(e.at.column)

@test
fn test_every_syntax_error_names_its_kind_and_its_place() [io]
    test.case("a variable tag never closed")
    test.assert(where_it_points("{{ x") == "unclosed {{@1:1")
    test.case("a statement tag never closed, on line 2")
    test.assert(where_it_points("a\n{% if x") == "unclosed {%@2:1")
    test.case("a comment never closed")
    test.assert(where_it_points("{# x") == "unclosed {#@1:1")
    test.case("a string that never ends")
    test.assert(where_it_points("{{ 'abc }}") == "unclosed string@1:4")
    test.case("a character that is in no token")
    test.assert(where_it_points("{{ x @ y }}") == "syntax @@1:6")
    test.case("an empty expression")
    test.assert(where_it_points("{{ }}") == "syntax the end of the tag@1:4")
    test.case("an empty statement")
    test.assert(where_it_points("{% %}") == "syntax the end of the tag@1:4")
    test.case("a filter without a name")
    test.assert(where_it_points("{{ x | }}") == "syntax the end of the tag@1:8")
    test.case("a parenthesis never closed")
    test.assert(where_it_points("{{ (x }}") == "syntax the end of the tag@1:7")
    test.case("a list missing a comma")
    test.assert(where_it_points("{{ [1 2] }}") == "syntax 2@1:7")
    test.case("an argument list missing a comma")
    test.assert(where_it_points("{{ f(1 2) }}") == "syntax 2@1:8")
    test.case("a dot with nothing after it")
    test.assert(where_it_points("{{ x.}}") == "syntax the end of the tag@1:6")
    test.case("a minus with no number")
    test.assert(where_it_points("{{ - }}") == "syntax the end of the tag@1:6")
    test.case("an index never closed")
    test.assert(where_it_points("{{ x[1 }}") == "syntax the end of the tag@1:8")
    test.case("two expressions in a row")
    test.assert(where_it_points("{{ a b }}") == "syntax b@1:6")
    test.case("a not with nothing after it")
    test.assert(where_it_points("{{ not }}") == "syntax the end of the tag@1:8")
    test.case("a test with no name")
    test.assert(where_it_points("{{ x is }}") == "syntax the end of the tag@1:9")
    test.case("a negated test with no name")
    test.assert(where_it_points("{{ x is not }}") == "syntax the end of the tag@1:13")
    test.case("a filter's argument list never closed")
    test.assert(where_it_points("{{ x | f(}}") == "syntax the end of the tag@1:10")
    test.case("a keyword argument with no value")
    test.assert(where_it_points("{{ x | f(a=) }}") == "syntax )@1:12")
    test.case("a for with no in")
    test.assert(where_it_points("{% for x %}") == "syntax the end of the tag@1:10")
    test.case("a for with no collection")
    test.assert(where_it_points("{% for x in %}") == "syntax the end of the tag@1:13")
    test.case("a for with a number for a name")
    test.assert(where_it_points("{% for 1 in y %}") == "syntax 1@1:8")
    test.case("a for with a comma and no second name")
    test.assert(where_it_points("{% for x, in y %}") == "syntax y@1:14")
    test.case("a set with no name")
    test.assert(where_it_points("{% set %}") == "syntax the end of the tag@1:8")
    test.case("a set with no equals sign")
    test.assert(where_it_points("{% set x %}") == "syntax the end of the tag@1:10")
    test.case("an if with no condition")
    test.assert(where_it_points("{% if %}") == "syntax the end of the tag@1:7")
    test.case("an if with two conditions")
    test.assert(where_it_points("{% if a b %}{% endif %}") == "syntax b@1:9")
    test.case("an include with no name")
    test.assert(where_it_points("{% include %}") == "syntax the end of the tag@1:12")
    test.case("an if never closed")
    test.assert(where_it_points("{% if x %}a") == "unclosed if@1:1")
    test.case("an if with an else never closed")
    test.assert(where_it_points("{% if x %}a{% else %}b") == "unclosed if@1:1")
    test.case("an if with an elif never closed")
    test.assert(where_it_points("{% if x %}a{% elif y %}b") == "unclosed if@1:1")
    test.case("a for never closed")
    test.assert(where_it_points("{% for x in y %}a") == "unclosed for@1:1")
    test.case("a for with an else never closed")
    test.assert(where_it_points("{% for x in y %}a{% else %}b") == "unclosed for@1:1")
    test.case("a block never closed")
    test.assert(where_it_points("{% block b %}") == "unclosed block@1:1")
    test.case("a macro never closed")
    test.assert(where_it_points("{% macro m() %}") == "unclosed macro@1:1")
    test.case("a filter block never closed")
    test.assert(where_it_points("{% filter upper %}") == "unclosed filter@1:1")
    test.case("a raw block never closed")
    test.assert(where_it_points("{% raw %}x") == "unclosed raw@1:1")
    test.case("a raw block whose end tag never closes")
    test.assert(where_it_points("{% raw %}x{% endraw") == "unclosed raw@1:1")
    test.case("a raw block with another tag inside and no end")
    test.assert(where_it_points("{% raw %}{% if x %}") == "unclosed raw@1:1")
    test.case("an endif with nothing open")
    test.assert(where_it_points("{% endif %}") == "unexpected endif@1:1")
    test.case("an else with nothing open")
    test.assert(where_it_points("{% else %}") == "unexpected else@1:1")
    test.case("an elif with nothing open")
    test.assert(where_it_points("{% elif x %}") == "unexpected elif@1:1")
    test.case("an endfor with nothing open")
    test.assert(where_it_points("{% endfor %}") == "unexpected endfor@1:1")
    test.case("an endif inside a for")
    test.assert(where_it_points("{% for x in y %}{% endif %}{% endfor %}") == "unexpected endif@1:17")
    test.case("an elif after an else")
    test.assert(where_it_points("{% if x %}{% else %}{% elif y %}{% endif %}") == "unexpected elif@1:21")
    test.case("a second else in a for")
    test.assert(where_it_points("{% for x in y %}{% else %}{% else %}{% endfor %}") == "unexpected else@1:27")
    test.case("an unknown tag")
    test.assert(where_it_points("{% frobnicate %}") == "syntax frobnicate@1:1")
    test.case("a while loop, which the language leaves out")
    test.assert(where_it_points("{% while x %}{% endwhile %}") == "syntax while@1:1")
    test.case("an extends that is not a literal")
    test.assert(where_it_points("{% extends x %}") == "syntax x@1:12")
    test.case("an extends inside an if")
    test.assert(where_it_points("{% if x %}{% extends 'a' %}{% endif %}") == "syntax a@1:22")
    test.case("an extends followed by more")
    test.assert(where_it_points("{% extends 'a' x %}") == "syntax x@1:16")
    test.case("an endblock naming another block")
    test.assert(where_it_points("{% block a %}{% endblock b %}") == "syntax b@1:26")
    test.case("a block name followed by more")
    test.assert(where_it_points("{% block a b %}{% endblock %}") == "syntax b@1:12")
    test.case("a block with no name")
    test.assert(where_it_points("{% block %}") == "syntax the end of the tag@1:10")
    test.case("an endblock with a name and more")
    test.assert(where_it_points("{% block a %}{% endblock a x %}") == "syntax x@1:28")
    test.case("a block defined twice")
    test.assert(where_it_points("{% block a %}{% endblock %}\n{% block a %}{% endblock %}") == "duplicate a@2:1")
    test.case("a macro with no parameter list")
    test.assert(where_it_points("{% macro m %}") == "syntax the end of the tag@1:12")
    test.case("a macro parameters missing a comma")
    test.assert(where_it_points("{% macro m(a b) %}{% endmacro %}") == "syntax b@1:14")
    test.case("a macro parameter that is a number")
    test.assert(where_it_points("{% macro m(1) %}{% endmacro %}") == "syntax 1@1:12")
    test.case("a macro default with no value")
    test.assert(where_it_points("{% macro m(a=) %}{% endmacro %}") == "syntax )@1:14")
    test.case("an import of a name")
    test.assert(where_it_points("{% import x as y %}") == "syntax x@1:11")
    test.case("an import with no as")
    test.assert(where_it_points("{% import 'a' %}") == "syntax the end of the tag@1:15")
    test.case("an import with no alias")
    test.assert(where_it_points("{% import 'a' as %}") == "syntax the end of the tag@1:18")
    test.case("an import with more after the alias")
    test.assert(where_it_points("{% import 'a' as y z %}") == "syntax z@1:20")
    test.case("a filter block with no name")
    test.assert(where_it_points("{% filter %}") == "syntax the end of the tag@1:11")
    test.case("a tag whose first word is a number")
    test.assert(where_it_points("{% 1 %}") == "syntax 1@1:4")

@test
fn test_the_compiler_is_what_parse_calls() [io]
    test.case("compile answers the same error parse does, and the program parse keeps")
    match teracompile.compile("p.html", "{% endif %}")
        Ok(_)  => test.assert(false)
        Err(e) => test.assert(describe(e) == "unexpected endif")
    match teracompile.compile("p.html", "{% block b %}{% endblock %}")
        Ok(program) => test.assert(program.block_names == ["b"])
        Err(_)      => test.assert(false)

@test
fn test_nesting_is_bounded() [io]
    test.case("two hundred open tags are accepted, one more is refused")
    test.assert(where_it_points(str.repeat("{% if x %}", 199) + str.repeat("{% endif %}", 199)) == "parsed")
    test.assert(str.starts_with(where_it_points(str.repeat("{% if x %}", 250)), "limit nesting@"))

    test.case("so do blocks that open without an expression, such as a filter block")
    test.assert(where_it_points(str.repeat("{% filter upper %}", 250)) != "parsed")
    test.assert(str.starts_with(where_it_points(str.repeat("{% filter upper %}", 250)), "limit nesting@"))

    test.case("parentheses count the same way")
    test.assert(where_it_points("{{ " + str.repeat("(", 150) + "1" + str.repeat(")", 150) + " }}") == "parsed")
    test.assert(str.starts_with(where_it_points("{{ " + str.repeat("(", 250) + "1" + str.repeat(")", 250) + " }}"),
                                "limit nesting@"))
