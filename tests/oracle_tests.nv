// oracle_tests.nv — cases whose expected text came from Jinja2.
//
// Generated by tools/oracle.py; do not edit by hand.  Each case is a
// template, a context and any other templates it reaches, and the
// expected text is what Jinja2 3.1 renders for it, run the way Tera
// behaves where the two differ (an unknown name is an error, the last
// newline is kept, the name's suffix decides autoescaping).  Jinja2
// spells a quote `&#34;`; the generator writes html-nv's `&quot;`.
//
// The last test compares `teraval.to_json` with Python's `json.dumps`
// in its compact form.

use std.test
use teraval
use teraparse
use terarender
use teraerror

fn ctx_of(v: teraval.TeraValue) -> teraval.TeraContext
    match teraval.context_from_map(v)
        Some(c) =>
            c
        None    =>
            teraval.context_new()

fn set_of(files: [teraerror.TeraSource]) -> teraparse.TeraSet [io]
    var s = teraparse.set_new()
    for f in files
        match teraparse.set_add(s, f.name, f.text)
            Ok(next) =>
                s = next
            Err(_)   =>
                continue
    s

fn expect(files: [teraerror.TeraSource], name: Str, ctx: teraval.TeraContext, want: Str) [io]
    match terarender.render_str(set_of(files), name, ctx)
        Ok(got) =>
            test.assert(got == want)
        Err(e)  =>
            println(teraerror.one_line(e))
            test.assert(false)

fn kind_of(e: teraerror.TeraError) -> Str
    match e.kind
        ErrorSyntax(_)           =>
            "ErrorSyntax"
        ErrorUnclosed(_)         =>
            "ErrorUnclosed"
        ErrorUnexpectedTag(_)    =>
            "ErrorUnexpectedTag"
        ErrorUnknownVariable(_)  =>
            "ErrorUnknownVariable"
        ErrorNoSuchField(_)      =>
            "ErrorNoSuchField"
        ErrorUnknownFilter(_, _) =>
            "ErrorUnknownFilter"
        ErrorFilterRefused(_, _) =>
            "ErrorFilterRefused"
        ErrorTemplateNotFound(_) =>
            "ErrorTemplateNotFound"
        ErrorCycle(_)            =>
            "ErrorCycle"
        ErrorDuplicateBlock(_)   =>
            "ErrorDuplicateBlock"
        ErrorLimit(_)            =>
            "ErrorLimit"

// A template that parses into the set but fails to render, or one that
// does not parse at all: either way the error's kind is what is asserted.
fn expect_error(files: [teraerror.TeraSource], name: Str, ctx: teraval.TeraContext, kind: Str) [io]
    var s = teraparse.set_new()
    for f in files
        match teraparse.set_add(s, f.name, f.text)
            Ok(next) =>
                s = next
            Err(e)   =>
                test.assert(kind_of(e) == kind)
                return
    match terarender.render_str(s, name, ctx)
        Ok(_)  =>
            test.assert(false)
        Err(e) =>
            test.assert(kind_of(e) == kind)

@test
fn test_oracle_output() [io]
    test.case("plain text is copied")
    expect([TeraSource { name: "page.html", text: "just text\n" }],
        "page.html",
        ctx_of(ValueMap([])),
        "just text\n")
    test.case("a string")
    expect([TeraSource { name: "page.html", text: "{{ x }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("hello") }])),
        "hello")
    test.case("an int")
    expect([TeraSource { name: "page.html", text: "{{ n }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(3) }])),
        "3")
    test.case("a negative int")
    expect([TeraSource { name: "page.html", text: "{{ n }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(-7) }])),
        "-7")
    test.case("a whole float keeps its point")
    expect([TeraSource { name: "page.html", text: "{{ f }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "f", value: ValueFloat(3.0) }])),
        "3.0")
    test.case("a float")
    expect([TeraSource { name: "page.html", text: "{{ f }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "f", value: ValueFloat(0.1) }])),
        "0.1")
    test.case("another float")
    expect([TeraSource { name: "page.html", text: "{{ f }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "f", value: ValueFloat(2.5) }])),
        "2.5")
    test.case("a dotted path")
    expect([TeraSource { name: "page.html", text: "{{ u.name }} {{ u.address.city }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "Ada Oslo")
    test.case("a list index with a dot")
    expect([TeraSource { name: "page.html", text: "{{ u.tags.1 }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "y")
    test.case("a list index with brackets")
    expect([TeraSource { name: "page.html", text: "{{ xs[0] }}{{ xs[1] }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(4), ValueInt(5)]) }])),
        "45")
    test.case("a map key with brackets")
    expect([TeraSource { name: "page.html", text: "{{ u['name'] }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "Ada")
    test.case("a key from a variable")
    expect([TeraSource { name: "page.html", text: "{{ u[k] }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) },
    TeraPair { key: "k", value: ValueStr("name") }])),
    "Ada")
    test.case("two expressions and text between")
    expect([TeraSource { name: "page.html", text: "<{{ a }}|{{ b }}>" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueStr("two") }])),
        "<1|two>")
    test.case("a string literal")
    expect([TeraSource { name: "page.html", text: "{{ 'it' }} {{ \"is\" }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "it is")
    test.case("an escaped quote in a literal")
    expect([TeraSource { name: "page.html", text: "{{ 'a\\'b' }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "a&#39;b")
    test.case("a number literal")
    expect([TeraSource { name: "page.html", text: "{{ 42 }} {{ 1.5 }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "42 1.5")
    test.case("a negative literal")
    expect([TeraSource { name: "page.html", text: "{{ -3 }}" }], "page.html", ctx_of(ValueMap([])), "-3")
    test.case("a non-ASCII string")
    expect([TeraSource { name: "page.html", text: "{{ x }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("héllo ✓") }])),
        "héllo ✓")
    test.case("a comment")
    expect([TeraSource { name: "page.html", text: "a{# gone #}b" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ab")
    test.case("a multi-line comment")
    expect([TeraSource { name: "page.html", text: "a{# one\ntwo #}b" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ab")
    test.case("a brace that is not a tag")
    expect([TeraSource { name: "page.html", text: "{ x } { % } {" }],
        "page.html",
        ctx_of(ValueMap([])),
        "{ x } { % } {")
    test.case("a closing brace pair inside a string")
    expect([TeraSource { name: "page.html", text: "{{ '}}' }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "}}")
    test.case("an unknown variable")
    expect_error([TeraSource { name: "page.html", text: "{{ missing }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ErrorUnknownVariable")
    test.case("an unknown field")
    expect_error([TeraSource { name: "page.html", text: "{{ u.nope }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "ErrorNoSuchField")
    test.case("an index past the end")
    expect_error([TeraSource { name: "page.html", text: "{{ xs.5 }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1)]) }])),
        "ErrorNoSuchField")

@test
fn test_oracle_autoescape() [io]
    test.case("a script in an html template")
    expect([TeraSource { name: "page.html", text: "<p>{{ x }}</p>" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<script>alert(1)</script>") }])),
        "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>")
    test.case("every one of the five characters")
    expect([TeraSource { name: "page.html", text: "{{ x }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("a&b<c>d\"e'f") }])),
        "a&amp;b&lt;c&gt;d&quot;e&#39;f")
    test.case("an attribute value")
    expect([TeraSource { name: "page.html", text: "<a title=\"{{ x }}\">t</a>" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("say \"hi\"") }])),
        "<a title=\"say &quot;hi&quot;\">t</a>")
    test.case("safe turns it off for the value")
    expect([TeraSource { name: "page.html", text: "{{ x | safe }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b>bold</b>") }])),
        "<b>bold</b>")
    test.case("safe is for that value only")
    expect([TeraSource { name: "page.html", text: "{{ x | safe }}{{ x }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b>") }])),
        "<b>&lt;b&gt;")
    test.case("escape is not applied twice")
    expect([TeraSource { name: "page.html", text: "{{ x | escape }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b>") }])),
        "&lt;b&gt;")
    test.case("a text template is not escaped")
    expect([TeraSource { name: "page.txt", text: "{{ x }}" }],
        "page.txt",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b> & co") }])),
        "<b> & co")
    test.case("an xml template is escaped")
    expect([TeraSource { name: "feed.xml", text: "{{ x }}" }],
        "feed.xml",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b>") }])),
        "&lt;b&gt;")
    test.case("an htm template is escaped")
    expect([TeraSource { name: "page.htm", text: "{{ x }}" }],
        "page.htm",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b>") }])),
        "&lt;b&gt;")
    test.case("a number is not touched")
    expect([TeraSource { name: "page.html", text: "{{ n }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(5) }])),
        "5")
    test.case("text outside a tag is not escaped")
    expect([TeraSource { name: "page.html", text: "<b>{{ x }}</b>" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("a") }])),
        "<b>a</b>")
    test.case("a macro's result is markup already")
    expect([TeraSource { name: "page.html",
        text: "{% macro b(t) %}<b>{{ t }}</b>{% endmacro %}{{ b('x<y') }}" }],
    "page.html", ctx_of(ValueMap([])), "<b>x&lt;y</b>")
    test.case("an included template is escaped like its parent")
    expect([TeraSource { name: "part.html", text: "[{{ x }}]" },
        TeraSource { name: "page.html", text: "{% include 'part.html' %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<i>") }])), "[&lt;i&gt;]")
    test.case("a loop item is escaped")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}{{ x }}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueStr("<a>"), ValueStr("b&")]) }])),
        "&lt;a&gt;b&amp;")

@test
fn test_oracle_conditions() [io]
    test.case("if true")
    expect([TeraSource { name: "page.html", text: "{% if x %}y{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueBool(true) }])),
        "y")
    test.case("if false")
    expect([TeraSource { name: "page.html", text: "{% if x %}y{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueBool(false) }])),
        "")
    test.case("if else")
    expect([TeraSource { name: "page.html", text: "{% if x %}y{% else %}n{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(0) }])),
        "n")
    test.case("elif")
    expect([TeraSource { name: "page.html",
        text: "{% if n == 1 %}a{% elif n == 2 %}b{% elif n == 3 %}c{% else %}d{% endif %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(2) }])), "b")
    test.case("the else after elifs")
    expect([TeraSource { name: "page.html",
        text: "{% if n == 1 %}a{% elif n == 2 %}b{% else %}d{% endif %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(9) }])), "d")
    test.case("zero is false")
    expect([TeraSource { name: "page.html", text: "{% if n %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(0) }])),
        "f")
    test.case("zero point zero is false")
    expect([TeraSource { name: "page.html", text: "{% if n %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueFloat(0.0) }])),
        "f")
    test.case("the empty string is false")
    expect([TeraSource { name: "page.html", text: "{% if s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueStr("") }])),
        "f")
    test.case("an empty list is false")
    expect([TeraSource { name: "page.html", text: "{% if s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueList([]) }])),
        "f")
    test.case("an empty map is false")
    expect([TeraSource { name: "page.html", text: "{% if s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueMap([]) }])),
        "f")
    test.case("a one-item list is true")
    expect([TeraSource { name: "page.html", text: "{% if s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueList([ValueInt(0)]) }])),
        "t")
    test.case("a string is true")
    expect([TeraSource { name: "page.html", text: "{% if s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueStr("0") }])),
        "t")
    test.case("null is false")
    expect([TeraSource { name: "page.html", text: "{% if s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueNull }])),
        "f")
    test.case("not")
    expect([TeraSource { name: "page.html", text: "{% if not x %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(0) }])),
        "t")
    test.case("and")
    expect([TeraSource { name: "page.html", text: "{% if a and b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueInt(0) }])),
        "f")
    test.case("or")
    expect([TeraSource { name: "page.html", text: "{% if a or b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(0) }, TeraPair { key: "b", value: ValueInt(1) }])),
        "t")
    test.case("and binds tighter than or")
    expect([TeraSource { name: "page.html", text: "{% if a or b and c %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) },
        TeraPair { key: "b", value: ValueInt(0) },
        TeraPair { key: "c", value: ValueInt(0) }])),
    "t")
    test.case("not binds tighter than and")
    expect([TeraSource { name: "page.html", text: "{% if not a and b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(0) }, TeraPair { key: "b", value: ValueInt(1) }])),
        "t")
    test.case("parentheses")
    expect([TeraSource { name: "page.html", text: "{% if (a or b) and c %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) },
        TeraPair { key: "b", value: ValueInt(0) },
        TeraPair { key: "c", value: ValueInt(0) }])),
    "f")
    test.case("equal ints")
    expect([TeraSource { name: "page.html", text: "{% if a == b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(2) }, TeraPair { key: "b", value: ValueInt(2) }])),
        "t")
    test.case("an int equals the same float")
    expect([TeraSource { name: "page.html", text: "{% if a == b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueFloat(1.0) }])),
        "t")
    test.case("unequal")
    expect([TeraSource { name: "page.html", text: "{% if a != b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueStr("x") }, TeraPair { key: "b", value: ValueStr("y") }])),
        "t")
    test.case("less")
    expect([TeraSource { name: "page.html", text: "{% if a < b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueInt(2) }])),
        "t")
    test.case("less or equal")
    expect([TeraSource { name: "page.html", text: "{% if a <= b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(2) }, TeraPair { key: "b", value: ValueInt(2) }])),
        "t")
    test.case("greater")
    expect([TeraSource { name: "page.html", text: "{% if a > b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(3) }, TeraPair { key: "b", value: ValueInt(2) }])),
        "t")
    test.case("greater or equal")
    expect([TeraSource { name: "page.html", text: "{% if a >= b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueInt(2) }])),
        "f")
    test.case("a string orders as bytes")
    expect([TeraSource { name: "page.html", text: "{% if a < b %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "a", value: ValueStr("apple") },
        TeraPair { key: "b", value: ValueStr("banana") }])),
    "t")
    test.case("an int against a float")
    expect([TeraSource { name: "page.html", text: "{% if a < b %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueFloat(1.5) }])),
        "t")
    test.case("in a list")
    expect([TeraSource { name: "page.html", text: "{% if 2 in xs %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "t")
    test.case("not in a list")
    expect([TeraSource { name: "page.html", text: "{% if 5 not in xs %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "t")
    test.case("in a string")
    expect([TeraSource { name: "page.html", text: "{% if 'ell' in s %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueStr("hello") }])),
        "t")
    test.case("in a map is a key")
    expect([TeraSource { name: "page.html", text: "{% if 'name' in u %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "t")
    test.case("a list equals a list")
    expect([TeraSource { name: "page.html", text: "{% if a == b %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "a", value: ValueList([ValueInt(1), ValueInt(2)]) },
        TeraPair { key: "b", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
    "t")
    test.case("a list is not another order")
    expect([TeraSource { name: "page.html", text: "{% if a == b %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "a", value: ValueList([ValueInt(1), ValueInt(2)]) },
        TeraPair { key: "b", value: ValueList([ValueInt(2), ValueInt(1)]) }])),
    "f")
    test.case("a map equals a map in another order")
    expect([TeraSource { name: "page.html", text: "{% if a == b %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "a",
        value: ValueMap([TeraPair { key: "x", value: ValueInt(1) }, TeraPair { key: "y", value: ValueInt(2) }]) },
    TeraPair { key: "b",
        value: ValueMap([TeraPair { key: "y", value: ValueInt(2) }, TeraPair { key: "x", value: ValueInt(1) }]) }])),
    "t")
    test.case("nested ifs")
    expect([TeraSource { name: "page.html",
        text: "{% if a %}{% if b %}ab{% else %}a{% endif %}{% else %}none{% endif %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueInt(0) }])), "a")
    test.case("a filter inside a condition")
    expect([TeraSource { name: "page.html", text: "{% if xs | length > 1 %}many{% else %}few{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "many")
    test.case("comparing a string with an int")
    expect_error([TeraSource { name: "page.html", text: "{% if a < b %}t{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "a", value: ValueStr("x") }, TeraPair { key: "b", value: ValueInt(1) }])),
        "ErrorFilterRefused")

@test
fn test_oracle_tests() [io]
    test.case("defined")
    expect([TeraSource { name: "page.html", text: "{% if x is defined %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "t")
    test.case("not defined")
    expect([TeraSource { name: "page.html", text: "{% if y is defined %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "f")
    test.case("undefined")
    expect([TeraSource { name: "page.html", text: "{% if y is undefined %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "t")
    test.case("is not defined")
    expect([TeraSource { name: "page.html", text: "{% if y is not defined %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "t")
    test.case("defined on a missing field")
    expect([TeraSource { name: "page.html", text: "{% if u.nick is defined %}t{% else %}f{% endif %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "f")
    test.case("string")
    expect([TeraSource { name: "page.html", text: "{% if x is string %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("a") }])),
        "t")
    test.case("not a string")
    expect([TeraSource { name: "page.html", text: "{% if x is string %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "f")
    test.case("number")
    expect([TeraSource { name: "page.html", text: "{% if x is number %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(1.5) }])),
        "t")
    test.case("an int is a number")
    expect([TeraSource { name: "page.html", text: "{% if x is number %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(2) }])),
        "t")
    test.case("odd")
    expect([TeraSource { name: "page.html", text: "{% if x is odd %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(3) }])),
        "t")
    test.case("even")
    expect([TeraSource { name: "page.html", text: "{% if x is even %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(3) }])),
        "f")
    test.case("divisibleby")
    expect([TeraSource { name: "page.html", text: "{% if x is divisibleby(3) %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(9) }])),
        "t")
    test.case("not divisibleby")
    expect([TeraSource { name: "page.html", text: "{% if x is divisibleby(4) %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(9) }])),
        "f")

@test
fn test_oracle_loops() [io]
    test.case("the body once per item")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}{{ x }}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueStr("a"), ValueStr("b"), ValueStr("c")]) }])),
        "abc")
    test.case("text between")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}<{{ x }}>{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "<1><2>")
    test.case("loop.index")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}{{ loop.index }}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueStr("a"), ValueStr("b"), ValueStr("c")]) }])),
        "123")
    test.case("loop.index0")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}{{ loop.index0 }}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueStr("a"), ValueStr("b"), ValueStr("c")]) }])),
        "012")
    test.case("loop.first")
    expect([TeraSource { name: "page.html",
        text: "{% for x in xs %}{% if loop.first %}F{% endif %}{{ x }}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])), "F12")
    test.case("loop.last")
    expect([TeraSource { name: "page.html",
        text: "{% for x in xs %}{{ x }}{% if not loop.last %},{% endif %}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2), ValueInt(3)]) }])), "1,2,3")
    test.case("loop.length")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}{{ loop.length }}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "22")
    test.case("an empty list takes the else")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}a{% else %}none{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([]) }])),
        "none")
    test.case("a full list skips the else")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}a{% else %}none{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1)]) }])),
        "a")
    test.case("nested loops")
    expect([TeraSource { name: "page.html",
        text: "{% for a in xs %}{% for b in ys %}{{ a }}{{ b }} {% endfor %}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) },
        TeraPair { key: "ys", value: ValueList([ValueStr("x"), ValueStr("y")]) }])),
    "1x 1y 2x 2y ")
    test.case("the inner loop variable is its own")
    expect([TeraSource { name: "page.html",
        text: "{% for a in xs %}{% for b in ys %}{{ loop.index }}{% endfor %}{{ loop.index }}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) },
        TeraPair { key: "ys", value: ValueList([ValueInt(1), ValueInt(2), ValueInt(3)]) }])),
    "12311232")
    test.case("a loop over a string")
    expect([TeraSource { name: "page.html", text: "{% for ch in s %}[{{ ch }}]{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "s", value: ValueStr("héy") }])),
        "[h][é][y]")
    test.case("a loop over a filtered list")
    expect([TeraSource { name: "page.html", text: "{% for x in xs | reverse %}{{ x }}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2), ValueInt(3)]) }])),
        "321")
    test.case("a variable set before the loop is seen inside")
    expect([TeraSource { name: "page.html",
        text: "{% set p = '>' %}{% for x in xs %}{{ p }}{{ x }}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])), "&gt;1&gt;2")
    test.case("a set inside the loop ends with it")
    expect([TeraSource { name: "page.html",
        text: "{% for x in xs %}{% set y = x %}{{ y }}{% endfor %}{% if y is defined %}leak{% else %}ok{% endif %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])), "12ok")
    test.case("a loop variable hides an outer one")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}{{ x }}{% endfor %}{{ x }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) },
        TeraPair { key: "x", value: ValueStr("out") }])),
    "12out")
    test.case("a loop over a list of maps")
    expect([TeraSource { name: "page.html", text: "{% for u in us %}{{ u.name }};{% endfor %}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "us", value: ValueList([ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]),
    ValueMap([TeraPair { key: "name", value: ValueStr("Bo") }])]) }])),
    "Ada;Bo;")
    test.case("a loop over a number")
    expect_error([TeraSource { name: "page.html", text: "{% for x in n %}{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(3) }])),
        "ErrorFilterRefused")

@test
fn test_oracle_set() [io]
    test.case("a number")
    expect([TeraSource { name: "page.html", text: "{% set n = 2 %}{{ n }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "2")
    test.case("a string")
    expect([TeraSource { name: "page.html", text: "{% set s = 'hi' %}{{ s }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "hi")
    test.case("from a variable")
    expect([TeraSource { name: "page.html", text: "{% set y = x %}{{ y }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("v") }])),
        "v")
    test.case("from a filter")
    expect([TeraSource { name: "page.html", text: "{% set y = x | upper %}{{ y }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("v") }])),
        "V")
    test.case("rebinding")
    expect([TeraSource { name: "page.html", text: "{% set n = 1 %}{% set n = 2 %}{{ n }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "2")
    test.case("from a path")
    expect([TeraSource { name: "page.html", text: "{% set c = u.address.city %}{{ c }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "Oslo")
    test.case("a list literal")
    expect([TeraSource { name: "page.html",
        text: "{% set xs = [1, 2, 3] %}{% for x in xs %}{{ x }}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([])), "123")
    test.case("a condition")
    expect([TeraSource { name: "page.html", text: "{% if n > 1 %}{% set m = 'big' %}{{ m }}{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "n", value: ValueInt(2) }])),
        "big")

@test
fn test_oracle_raw() [io]
    test.case("raw keeps a variable")
    expect([TeraSource { name: "page.html", text: "{% raw %}{{ x }}{% endraw %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "{{ x }}")
    test.case("raw keeps a tag")
    expect([TeraSource { name: "page.html", text: "{% raw %}{% if x %}{% endraw %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "{% if x %}")
    test.case("raw around other text")
    expect([TeraSource { name: "page.html", text: "a{% raw %} {{ b }} {% endraw %}c" }],
        "page.html",
        ctx_of(ValueMap([])),
        "a {{ b }} c")
    test.case("raw with a comment opener")
    expect([TeraSource { name: "page.html", text: "{% raw %}{# kept #}{% endraw %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "{# kept #}")

@test
fn test_oracle_whitespace() [io]
    test.case("dash on a tag's left strips the text before")
    expect([TeraSource { name: "page.html", text: "a  \n  {%- if x %}b{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "ab")
    test.case("dash on a tag's right strips the text after")
    expect([TeraSource { name: "page.html", text: "{% if x -%}  \n  b{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "b")
    test.case("both sides")
    expect([TeraSource { name: "page.html", text: "a \n{%- if x -%}\n b \n{%- endif -%}\n c" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "abc")
    test.case("dash on an expression")
    expect([TeraSource { name: "page.html", text: "a  {{- x -}}  b" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "a1b")
    test.case("dash on a comment")
    expect([TeraSource { name: "page.html", text: "a  {#- gone -#}  b" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ab")
    test.case("newlines are kept without a dash")
    expect([TeraSource { name: "page.html", text: "a\n{% if x %}\nb\n{% endif %}\nc" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "a\n\nb\n\nc")
    test.case("a loop that keeps its lines")
    expect([TeraSource { name: "page.html", text: "{% for x in xs %}\n- {{ x }}\n{% endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "\n- 1\n\n- 2\n")
    test.case("a loop that strips its lines")
    expect([TeraSource { name: "page.html", text: "{% for x in xs -%}\n- {{ x }}\n{%- endfor %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])),
        "- 1- 2")
    test.case("a trailing newline is kept")
    expect([TeraSource { name: "page.html", text: "a\n" }], "page.html", ctx_of(ValueMap([])), "a\n")
    test.case("raw with dashes")
    expect([TeraSource { name: "page.html", text: "a  {%- raw -%}  {{ x }}  {%- endraw -%}  b" }],
        "page.html",
        ctx_of(ValueMap([])),
        "a{{ x }}b")

@test
fn test_oracle_filters() [io]
    test.case("upper")
    expect([TeraSource { name: "page.html", text: "{{ x | upper }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("hello") }])),
        "HELLO")
    test.case("lower")
    expect([TeraSource { name: "page.html", text: "{{ x | lower }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("HeLLo") }])),
        "hello")
    test.case("capitalize")
    expect([TeraSource { name: "page.html", text: "{{ x | capitalize }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("hELLO wORLD") }])),
        "Hello world")
    test.case("title")
    expect([TeraSource { name: "page.html", text: "{{ x | title }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("hello wORLD-foo") }])),
        "Hello World-Foo")
    test.case("trim")
    expect([TeraSource { name: "page.html", text: "[{{ x | trim }}]" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("  a b \n") }])),
        "[a b]")
    test.case("length of a string counts characters")
    expect([TeraSource { name: "page.html", text: "{{ x | length }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("héllo") }])),
        "5")
    test.case("length of a list")
    expect([TeraSource { name: "page.html", text: "{{ x | length }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(1), ValueInt(2), ValueInt(3)]) }])),
        "3")
    test.case("length of a map")
    expect([TeraSource { name: "page.html", text: "{{ x | length }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "x",
        value: ValueMap([TeraPair { key: "a", value: ValueInt(1) }, TeraPair { key: "b", value: ValueInt(2) }]) }])),
    "2")
    test.case("wordcount")
    expect([TeraSource { name: "page.html", text: "{{ x | wordcount }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("one two  three\nfour") }])),
        "4")
    test.case("replace")
    expect([TeraSource { name: "page.html", text: "{{ x | replace('a', 'o') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("banana") }])),
        "bonono")
    test.case("replace with a longer text")
    expect([TeraSource { name: "page.html", text: "{{ x | replace('an', 'ANT') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("banana") }])),
        "bANTANTa")
    test.case("indent")
    expect([TeraSource { name: "page.txt", text: "{{ x | indent(2) }}" }],
        "page.txt",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("a\nb\n\nc") }])),
        "a\n  b\n\n  c")
    test.case("indent with a trailing newline")
    expect([TeraSource { name: "page.txt", text: "{{ x | indent(4) }}" }],
        "page.txt",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("a\nb\n") }])),
        "a\n    b\n")
    test.case("striptags")
    expect([TeraSource { name: "page.txt", text: "{{ x | striptags }}" }],
        "page.txt",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<b>bold</b> and <i>it</i>") }])),
        "bold and it")
    test.case("first")
    expect([TeraSource { name: "page.html", text: "{{ x | first }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(7), ValueInt(8)]) }])),
        "7")
    test.case("last")
    expect([TeraSource { name: "page.html", text: "{{ x | last }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(7), ValueInt(8)]) }])),
        "8")
    test.case("first of a string")
    expect([TeraSource { name: "page.html", text: "{{ x | first }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("héy") }])),
        "h")
    test.case("last of a string")
    expect([TeraSource { name: "page.html", text: "{{ x | last }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("hey") }])),
        "y")
    test.case("reverse a list")
    expect([TeraSource { name: "page.html", text: "{{ x | reverse | join(',') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(1), ValueInt(2), ValueInt(3)]) }])),
        "3,2,1")
    test.case("reverse a string")
    expect([TeraSource { name: "page.html", text: "{{ x | reverse }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("abc") }])),
        "cba")
    test.case("join")
    expect([TeraSource { name: "page.html", text: "{{ x | join(', ') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueStr("a"), ValueStr("b"), ValueStr("c")]) }])),
        "a, b, c")
    test.case("join without a separator")
    expect([TeraSource { name: "page.html", text: "{{ x | join }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueStr("a"), ValueStr("b")]) }])),
        "ab")
    test.case("join numbers")
    expect([TeraSource { name: "page.html", text: "{{ x | join('-') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(1), ValueInt(2), ValueInt(3)]) }])),
        "1-2-3")
    test.case("sort numbers")
    expect([TeraSource { name: "page.html", text: "{{ x | sort | join(',') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(3), ValueInt(1), ValueInt(2)]) }])),
        "1,2,3")
    test.case("sort floats and ints")
    expect([TeraSource { name: "page.html", text: "{{ x | sort | join(',') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(2), ValueFloat(1.5), ValueInt(1)]) }])),
        "1,1.5,2")
    test.case("sort words")
    expect([TeraSource { name: "page.html", text: "{{ x | sort | join(',') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueStr("pear"), ValueStr("apple"), ValueStr("fig")]) }])),
        "apple,fig,pear")
    test.case("sort by a field")
    expect([TeraSource { name: "page.html",
        text: "{{ x | sort(attribute='n') | map(attribute='s') | join(',') }}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueMap([TeraPair { key: "n", value: ValueInt(2) }, TeraPair { key: "s", value: ValueStr("b") }]),
        ValueMap([TeraPair { key: "n", value: ValueInt(1) }, TeraPair { key: "s", value: ValueStr("a") }]),
        ValueMap([TeraPair { key: "n", value: ValueInt(3) }, TeraPair { key: "s", value: ValueStr("c") }])]) }])),
    "a,b,c")
    test.case("sort keeps equal items in order")
    expect([TeraSource { name: "page.html",
        text: "{{ x | sort(attribute='n') | map(attribute='s') | join(',') }}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueMap([TeraPair { key: "n", value: ValueInt(1) }, TeraPair { key: "s", value: ValueStr("a") }]),
        ValueMap([TeraPair { key: "n", value: ValueInt(0) }, TeraPair { key: "s", value: ValueStr("z") }]),
        ValueMap([TeraPair { key: "n", value: ValueInt(1) }, TeraPair { key: "s", value: ValueStr("b") }])]) }])),
    "z,a,b")
    test.case("unique")
    expect([TeraSource { name: "page.html", text: "{{ x | unique | join(',') }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "x",
        value: ValueList([ValueInt(1), ValueInt(2), ValueInt(1), ValueInt(3), ValueInt(2)]) }])),
    "1,2,3")
    test.case("unique words")
    expect([TeraSource { name: "page.html", text: "{{ x | unique | join(',') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueStr("a"), ValueStr("b"), ValueStr("a")]) }])),
        "a,b")
    test.case("map a field")
    expect([TeraSource { name: "page.html", text: "{{ x | map(attribute='n') | join(',') }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueMap([TeraPair { key: "n", value: ValueInt(1) }]),
        ValueMap([TeraPair { key: "n", value: ValueInt(2) }])]) }])),
    "1,2")
    test.case("abs of an int")
    expect([TeraSource { name: "page.html", text: "{{ x | abs }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(-5) }])),
        "5")
    test.case("abs of a float")
    expect([TeraSource { name: "page.html", text: "{{ x | abs }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(-2.5) }])),
        "2.5")
    test.case("round a float")
    expect([TeraSource { name: "page.html", text: "{{ x | round }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(3.7) }])),
        "4.0")
    test.case("round down")
    expect([TeraSource { name: "page.html", text: "{{ x | round }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(3.2) }])),
        "3.0")
    test.case("round to places")
    expect([TeraSource { name: "page.html", text: "{{ x | round(2) }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(3.14159) }])),
        "3.14")
    test.case("round a negative")
    expect([TeraSource { name: "page.html", text: "{{ x | round }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(-3.7) }])),
        "-4.0")
    test.case("round an int")
    expect([TeraSource { name: "page.html", text: "{{ x | round }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(5) }])),
        "5")
    test.case("int of a float")
    expect([TeraSource { name: "page.html", text: "{{ x | int }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(3.9) }])),
        "3")
    test.case("int of a negative float")
    expect([TeraSource { name: "page.html", text: "{{ x | int }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueFloat(-3.9) }])),
        "-3")
    test.case("int of a string")
    expect([TeraSource { name: "page.html", text: "{{ x | int }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("42") }])),
        "42")
    test.case("int of text with a fraction")
    expect([TeraSource { name: "page.html", text: "{{ x | int }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("3.7") }])),
        "3")
    test.case("int of words")
    expect([TeraSource { name: "page.html", text: "{{ x | int }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("abc") }])),
        "0")
    test.case("int of words with a default")
    expect([TeraSource { name: "page.html", text: "{{ x | int(5) }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("abc") }])),
        "5")
    test.case("float of an int")
    expect([TeraSource { name: "page.html", text: "{{ x | float }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(3) }])),
        "3.0")
    test.case("float of a string")
    expect([TeraSource { name: "page.html", text: "{{ x | float }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("2.5") }])),
        "2.5")
    test.case("filesizeformat zero")
    expect([TeraSource { name: "page.html", text: "{{ x | filesizeformat }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(0) }])),
        "0 Bytes")
    test.case("filesizeformat one")
    expect([TeraSource { name: "page.html", text: "{{ x | filesizeformat }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "1 Byte")
    test.case("filesizeformat bytes")
    expect([TeraSource { name: "page.html", text: "{{ x | filesizeformat }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(999) }])),
        "999 Bytes")
    test.case("filesizeformat a thousand")
    expect([TeraSource { name: "page.html", text: "{{ x | filesizeformat }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1000) }])),
        "1.0 kB")
    test.case("filesizeformat megabytes")
    expect([TeraSource { name: "page.html", text: "{{ x | filesizeformat }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1500000) }])),
        "1.5 MB")
    test.case("filesizeformat gigabytes")
    expect([TeraSource { name: "page.html", text: "{{ x | filesizeformat }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(123456789012) }])),
        "123.5 GB")
    test.case("urlencode")
    expect([TeraSource { name: "page.txt", text: "{{ x | urlencode }}" }],
        "page.txt",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("a b/c?d=é") }])),
        "a%20b/c%3Fd%3D%C3%A9")
    test.case("escape")
    expect([TeraSource { name: "page.txt", text: "{{ x | escape }}" }],
        "page.txt",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("<a href=\"x\">") }])),
        "&lt;a href=&quot;x&quot;&gt;")
    test.case("default on a missing name")
    expect([TeraSource { name: "page.html", text: "{{ y | default('-') }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "-")
    test.case("default on a missing field")
    expect([TeraSource { name: "page.html", text: "{{ u.nick | default('anon') }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "anon")
    test.case("default leaves a value alone")
    expect([TeraSource { name: "page.html", text: "{{ x | default('-') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("set") }])),
        "set")
    test.case("default does not replace an empty string")
    expect([TeraSource { name: "page.html", text: "[{{ x | default('-') }}]" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("") }])),
        "[]")
    test.case("default with true replaces a false value")
    expect([TeraSource { name: "page.html", text: "[{{ x | default('-', true) }}]" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("") }])),
        "[-]")
    test.case("default leaves zero alone")
    expect([TeraSource { name: "page.html", text: "{{ x | default('-') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(0) }])),
        "0")
    test.case("a chain")
    expect([TeraSource { name: "page.html", text: "{{ x | trim | upper | replace('A', 'a') }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("  banana ") }])),
        "BaNaNa")
    test.case("a filter on a literal")
    expect([TeraSource { name: "page.html", text: "{{ 'abc' | upper }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ABC")
    test.case("a filter on a path")
    expect([TeraSource { name: "page.html", text: "{{ u.name | lower }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "name", value: ValueStr("Ada") }, TeraPair { key: "tags", value: ValueList([ValueStr("x"), ValueStr("y")]) }, TeraPair { key: "address",
        value: ValueMap([TeraPair { key: "city", value: ValueStr("Oslo") }]) }]) }])),
    "ada")
    test.case("a filter with an argument from a variable")
    expect([TeraSource { name: "page.html", text: "{{ x | join(sep) }}" }], "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueList([ValueInt(1), ValueInt(2)]) },
        TeraPair { key: "sep", value: ValueStr("+") }])),
    "1+2")
    test.case("a filter binds tighter than a comparison")
    expect([TeraSource { name: "page.html", text: "{% if x | length == 3 %}t{% else %}f{% endif %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("abc") }])),
        "t")
    test.case("filter block")
    expect([TeraSource { name: "page.html", text: "{% filter upper %}hello {{ x }}{% endfilter %}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueStr("there") }])),
        "HELLO THERE")
    test.case("an unknown filter")
    expect_error([TeraSource { name: "page.html", text: "{{ x | nofilter }}" }],
        "page.html",
        ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])),
        "ErrorUnknownFilter")

@test
fn test_oracle_inheritance() [io]
    test.case("a child fills a block")
    expect([TeraSource { name: "base.html", text: "<main>{% block content %}base{% endblock %}</main>" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block content %}child{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<main>child</main>")
    test.case("a block the child leaves alone keeps the parent's text")
    expect([TeraSource { name: "base.html", text: "<main>{% block content %}base{% endblock %}</main>" },
        TeraSource { name: "page.html", text: "{% extends 'base.html' %}" }],
    "page.html", ctx_of(ValueMap([])), "<main>base</main>")
    test.case("text outside the child's blocks is dropped")
    expect([TeraSource { name: "base.html", text: "[{% block content %}{% endblock %}]" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}ignored{% block content %}child{% endblock %}ignored" }],
    "page.html", ctx_of(ValueMap([])), "[child]")
    test.case("super")
    expect([TeraSource { name: "base.html", text: "{% block content %}base{% endblock %}" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block content %}{{ super() }}+child{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "base+child")
    test.case("super twice in a row")
    expect([TeraSource { name: "base.html", text: "{% block content %}b{% endblock %}" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block content %}{{ super() }}{{ super() }}{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "bb")
    test.case("two blocks")
    expect([TeraSource { name: "base.html",
        text: "{% block a %}a{% endblock %}-{% block b %}b{% endblock %}" },
    TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block a %}A{% endblock %}{% block b %}B{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "A-B")
    test.case("three levels, the nearest wins")
    expect([TeraSource { name: "mid.html", text: "{% extends 'root.html' %}{% block x %}mid{% endblock %}" },
        TeraSource { name: "root.html", text: "<{% block x %}root{% endblock %}>" },
        TeraSource { name: "page.html", text: "{% extends 'mid.html' %}{% block x %}top{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<top>")
    test.case("three levels, super goes up one at a time")
    expect([TeraSource { name: "mid.html",
        text: "{% extends 'root.html' %}{% block x %}{{ super() }}+mid{% endblock %}" },
    TeraSource { name: "root.html", text: "<{% block x %}root{% endblock %}>" }, TeraSource { name: "page.html",
        text: "{% extends 'mid.html' %}{% block x %}{{ super() }}+top{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<root+mid+top>")
    test.case("three levels, a middle level that does not override")
    expect([TeraSource { name: "mid.html", text: "{% extends 'root.html' %}" }, TeraSource { name: "root.html", text: "<{% block x %}root{% endblock %}>" }, TeraSource { name: "page.html",
        text: "{% extends 'mid.html' %}{% block x %}{{ super() }}+top{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<root+top>")
    test.case("a block inside a block")
    expect([TeraSource { name: "base.html",
        text: "{% block outer %}[{% block inner %}in{% endblock %}]{% endblock %}" },
    TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block inner %}INNER{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "[INNER]")
    test.case("a child overrides the outer block and the inner one stays")
    expect([TeraSource { name: "base.html",
        text: "{% block outer %}[{% block inner %}in{% endblock %}]{% endblock %}" },
    TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block outer %}<{% block inner %}new{% endblock %}>{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<new>")
    test.case("the context reaches the blocks")
    expect([TeraSource { name: "base.html", text: "{% block content %}{% endblock %}" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block content %}{{ title }}{% endblock %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "title", value: ValueStr("Home") }])), "Home")
    test.case("the parent's own variables")
    expect([TeraSource { name: "base.html", text: "{{ site }}:{% block content %}{% endblock %}" },
        TeraSource { name: "page.html", text: "{% extends 'base.html' %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "site", value: ValueStr("S") }])), "S:")
    test.case("a block named with the end name")
    expect([TeraSource { name: "base.html", text: "{% block content %}b{% endblock content %}" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block content %}c{% endblock content %}" }],
    "page.html", ctx_of(ValueMap([])), "c")
    test.case("extending a template that is not there")
    expect_error([TeraSource { name: "page.html", text: "{% extends 'nowhere.html' %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ErrorTemplateNotFound")
    test.case("a block defined twice")
    expect_error([TeraSource { name: "page.html", text: "{% block a %}{% endblock %}{% block a %}{% endblock %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ErrorDuplicateBlock")

@test
fn test_oracle_include() [io]
    test.case("an include")
    expect([TeraSource { name: "part.html", text: "[part]" },
        TeraSource { name: "page.html", text: "a{% include 'part.html' %}b" }],
    "page.html", ctx_of(ValueMap([])), "a[part]b")
    test.case("an include sees the context")
    expect([TeraSource { name: "part.html", text: "x={{ x }}" },
        TeraSource { name: "page.html", text: "{% include 'part.html' %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(5) }])), "x=5")
    test.case("an include sees the loop variable")
    expect([TeraSource { name: "part.html", text: "<{{ x }}>" },
        TeraSource { name: "page.html", text: "{% for x in xs %}{% include 'part.html' %}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])), "<1><2>")
    test.case("an include sees a set variable")
    expect([TeraSource { name: "part.html", text: "{{ v }}" },
        TeraSource { name: "page.html", text: "{% set v = 'S' %}{% include 'part.html' %}" }],
    "page.html", ctx_of(ValueMap([])), "S")
    test.case("an include that includes")
    expect([TeraSource { name: "a.html", text: "a({% include 'b.html' %})" },
        TeraSource { name: "b.html", text: "b" },
        TeraSource { name: "page.html", text: "{% include 'a.html' %}" }],
    "page.html", ctx_of(ValueMap([])), "a(b)")
    test.case("an include of a computed name")
    expect([TeraSource { name: "part.html", text: "computed" },
        TeraSource { name: "page.html", text: "{% include name %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "name", value: ValueStr("part.html") }])), "computed")
    test.case("an include of a template that extends")
    expect([TeraSource { name: "child.html", text: "{% extends 'base.html' %}{% block c %}C{% endblock %}" },
        TeraSource { name: "base.html", text: "<{% block c %}{% endblock %}>" },
        TeraSource { name: "page.html", text: "{% include 'child.html' %}" }],
    "page.html", ctx_of(ValueMap([])), "<C>")
    test.case("an include inside a block")
    expect([TeraSource { name: "base.html", text: "<{% block c %}{% endblock %}>" }, TeraSource { name: "part.html", text: "P" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% block c %}{% include 'part.html' %}{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<P>")
    test.case("an include inside an if")
    expect([TeraSource { name: "part.html", text: "P" },
        TeraSource { name: "page.html", text: "{% if x %}{% include 'part.html' %}{% endif %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "x", value: ValueInt(1) }])), "P")
    test.case("an include that is not there")
    expect_error([TeraSource { name: "page.html", text: "{% include 'nowhere.html' %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ErrorTemplateNotFound")
    test.case("an include that includes itself")
    expect_error([TeraSource { name: "page.html", text: "{% include 'page.html' %}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ErrorCycle")

@test
fn test_oracle_macros() [io]
    test.case("a macro")
    expect([TeraSource { name: "page.html",
        text: "{% macro hi(n) %}Hello {{ n }}{% endmacro %}{{ hi('Ada') }}" }],
    "page.html", ctx_of(ValueMap([])), "Hello Ada")
    test.case("two arguments")
    expect([TeraSource { name: "page.html",
        text: "{% macro add(a, b) %}{{ a }}+{{ b }}{% endmacro %}{{ add(1, 2) }}" }],
    "page.html", ctx_of(ValueMap([])), "1+2")
    test.case("a default")
    expect([TeraSource { name: "page.html",
        text: "{% macro hi(n='you') %}Hello {{ n }}{% endmacro %}{{ hi() }}" }],
    "page.html", ctx_of(ValueMap([])), "Hello you")
    test.case("a default overridden")
    expect([TeraSource { name: "page.html",
        text: "{% macro hi(n='you') %}Hello {{ n }}{% endmacro %}{{ hi('Ada') }}" }],
    "page.html", ctx_of(ValueMap([])), "Hello Ada")
    test.case("a keyword argument")
    expect([TeraSource { name: "page.html",
        text: "{% macro hi(a, b) %}{{ a }}{{ b }}{% endmacro %}{{ hi(b='B', a='A') }}" }],
    "page.html", ctx_of(ValueMap([])), "AB")
    test.case("a macro called twice")
    expect([TeraSource { name: "page.html",
        text: "{% macro b(t) %}<{{ t }}>{% endmacro %}{{ b(1) }}{{ b(2) }}" }],
    "page.html", ctx_of(ValueMap([])), "<1><2>")
    test.case("a macro in a loop")
    expect([TeraSource { name: "page.html",
        text: "{% macro b(t) %}<{{ t }}>{% endmacro %}{% for x in xs %}{{ b(x) }}{% endfor %}" }],
    "page.html", ctx_of(ValueMap([TeraPair { key: "xs", value: ValueList([ValueInt(1), ValueInt(2)]) }])), "<1><2>")
    test.case("a macro calling a macro")
    expect([TeraSource { name: "page.html",
        text: "{% macro a() %}A{{ b() }}{% endmacro %}{% macro b() %}B{% endmacro %}{{ a() }}" }],
    "page.html", ctx_of(ValueMap([])), "AB")
    test.case("a macro that loops")
    expect([TeraSource { name: "page.html",
        text: "{% macro l(xs) %}{% for x in xs %}{{ x }}{% endfor %}{% endmacro %}{{ l([1, 2, 3]) }}" }],
    "page.html", ctx_of(ValueMap([])), "123")
    test.case("an imported macro")
    expect([TeraSource { name: "m.html", text: "{% macro hi(n) %}Hi {{ n }}{% endmacro %}" },
        TeraSource { name: "page.html", text: "{% import 'm.html' as m %}{{ m.hi('Ada') }}" }],
    "page.html", ctx_of(ValueMap([])), "Hi Ada")
    test.case("two imported macros")
    expect([TeraSource { name: "m.html",
        text: "{% macro a() %}A{% endmacro %}{% macro b() %}B{% endmacro %}" },
    TeraSource { name: "page.html", text: "{% import 'm.html' as m %}{{ m.a() }}{{ m.b() }}" }],
    "page.html", ctx_of(ValueMap([])), "AB")
    test.case("an import under two names")
    expect([TeraSource { name: "m.html", text: "{% macro a() %}A{% endmacro %}" }, TeraSource { name: "page.html",
        text: "{% import 'm.html' as x %}{% import 'm.html' as y %}{{ x.a() }}{{ y.a() }}" }],
    "page.html", ctx_of(ValueMap([])), "AA")
    test.case("an imported macro uses its own file's macros")
    expect([TeraSource { name: "m.html",
        text: "{% macro a() %}[{{ b() }}]{% endmacro %}{% macro b() %}B{% endmacro %}" },
    TeraSource { name: "page.html", text: "{% import 'm.html' as m %}{{ m.a() }}" }],
    "page.html", ctx_of(ValueMap([])), "[B]")
    test.case("an import in a child's block")
    expect([TeraSource { name: "base.html", text: "<{% block c %}{% endblock %}>" }, TeraSource { name: "m.html", text: "{% macro a() %}A{% endmacro %}" }, TeraSource { name: "page.html",
        text: "{% extends 'base.html' %}{% import 'm.html' as m %}{% block c %}{{ m.a() }}{% endblock %}" }],
    "page.html", ctx_of(ValueMap([])), "<A>")
    test.case("a macro result goes through a filter")
    expect([TeraSource { name: "page.html", text: "{% macro m() %}ab{% endmacro %}{{ m() | upper }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "AB")
    test.case("a macro that is not there")
    expect_error([TeraSource { name: "m.html", text: "" },
        TeraSource { name: "page.html", text: "{% import 'm.html' as m %}{{ m.nope() }}" }],
    "page.html", ctx_of(ValueMap([])), "ErrorNoSuchField")
    test.case("an import that is not there")
    expect_error([TeraSource { name: "page.html", text: "{% import 'nowhere.html' as m %}{{ m.a() }}" }],
        "page.html",
        ctx_of(ValueMap([])),
        "ErrorTemplateNotFound")

@test
fn test_oracle_json_text() [io]
    test.case("to_json of null")
    test.assert(teraval.to_json(ValueNull) == "null")
    test.case("to_json of true")
    test.assert(teraval.to_json(ValueBool(true)) == "true")
    test.case("to_json of false")
    test.assert(teraval.to_json(ValueBool(false)) == "false")
    test.case("to_json of an int")
    test.assert(teraval.to_json(ValueInt(42)) == "42")
    test.case("to_json of a negative int")
    test.assert(teraval.to_json(ValueInt(-7)) == "-7")
    test.case("to_json of a float")
    test.assert(teraval.to_json(ValueFloat(2.5)) == "2.5")
    test.case("to_json of a whole float")
    test.assert(teraval.to_json(ValueFloat(3.0)) == "3.0")
    test.case("to_json of a string")
    test.assert(teraval.to_json(ValueStr("hello")) == "\"hello\"")
    test.case("to_json of quotes and a backslash")
    test.assert(teraval.to_json(ValueStr("a\"b\\c")) == "\"a\\\"b\\\\c\"")
    test.case("to_json of control characters")
    test.assert(teraval.to_json(ValueStr("a\nb\tc\rd\u{1}e")) == "\"a\\nb\\tc\\rd\\u0001e\"")
    test.case("to_json of non-ASCII text")
    test.assert(teraval.to_json(ValueStr("héllo ✓")) == "\"héllo ✓\"")
    test.case("to_json of an empty list")
    test.assert(teraval.to_json(ValueList([])) == "[]")
    test.case("to_json of a list")
    test.assert(teraval.to_json(ValueList([ValueInt(1), ValueStr("a"), ValueNull, ValueFloat(2.5)])) == "[1,\"a\",null,2.5]")
    test.case("to_json of an empty map")
    test.assert(teraval.to_json(ValueMap([])) == "{}")
    test.case("to_json of a map")
    test.assert(teraval.to_json(ValueMap([TeraPair { key: "a", value: ValueInt(1) },
        TeraPair { key: "b", value: ValueList([ValueBool(true), ValueNull]) }])) == "{\"a\":1,\"b\":[true,null]}")
    test.case("to_json of a nested value")
    test.assert(teraval.to_json(ValueMap([TeraPair { key: "u", value: ValueMap([TeraPair { key: "tags",
        value: ValueList([ValueStr("x"), ValueMap([TeraPair { key: "y", value: ValueInt(1) }])]) }]) },
    TeraPair { key: "n", value: ValueInt(-1) }])) == "{\"u\":{\"tags\":[\"x\",{\"y\":1}]},\"n\":-1}")
