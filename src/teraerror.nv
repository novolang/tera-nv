// teraerror.nv — what went wrong, where, and through which include.
//
// An error names the template, the line and the column of the fault. A
// page may extend a base that includes a header that includes a
// navigation bar, and one line number describes none of that, so an
// error also carries the chain of templates the renderer was in.
// `TeraError.chain` lists them innermost first, each with the position
// in it that led to the next, the way a backtrace does.

use std.str
use std.list

// TeraSpan is a position in one template.
pub struct TeraSpan
    // The name the template was added to the set under — a file path,
    // usually, but this package never opens a file so it is whatever
    // the caller called it.
    template: Str
    // 1-based, because a template is a file a person edits and an
    // editor counts from 1.
    line: Int
    // 1-based, in BYTES rather than in columns.  Bytes because that is
    // what a caller slices with; a display column would need a Unicode
    // width table for an error message, which is a dependency an error
    // message should not carry.
    column: Int
    // The byte offset into the template source, for a caller that
    // wants to point at the text itself.
    offset: Int

// TeraFrame is one level of the include and extends stack.
pub struct TeraFrame
    // Where in this template the next one was reached from.
    at: TeraSpan
    // How: an include, an extends, a block being overridden, or a
    // macro being called.
    how: TeraFrameKind

// TeraFrameKind says how one template reached another.
pub enum TeraFrameKind
    FrameInclude
    FrameExtends
    // A block defined in a child template, rendered where the parent
    // put it.  The one a reader cannot work out from the file, because
    // the text is in one template and the position is in another.
    FrameBlock(name: Str)
    FrameMacro(name: Str)

// TeraErrorKind is what went wrong.
//
// A named set rather than a message string, so that a caller can
// branch: a missing template is something a host can go and read, and
// a syntax error is not.
pub enum TeraErrorKind
    // The template did not parse.  `found` is what was there.
    ErrorSyntax(found: Str)
    // A tag that was opened and never closed — `{% for %}` with no
    // `{% endfor %}`.
    ErrorUnclosed(tag: Str)
    // An `{% endfor %}` with no `{% for %}`, or an `{% else %}` where
    // nothing branches. `set_check` also uses it, with the tag `block
    // <name>`, for a block that a child overrides and no parent defines.
    ErrorUnexpectedTag(tag: Str)
    // A name the context does not hold.  The most common error there
    // is, and the reason it names the variable and not just the line.
    ErrorUnknownVariable(name: Str)
    // A field or index the value does not have. Also a macro the
    // template does not define, a `super()` with no parent block, and a
    // block that `render_block` was asked for and the template lacks.
    ErrorNoSuchField(path: Str)
    // A filter or test name the registry does not hold.  `suggestion` is the
    // nearest name that is in it, or empty — a misspelled filter is
    // the second most common error and a suggestion turns it into a
    // typo.
    ErrorUnknownFilter(name: Str, suggestion: Str)
    // A filter refused its input: `upper` on a list, `length` on a
    // number.  `filter` names it and `because` says what it wanted.
    ErrorFilterRefused(filter: Str, because: Str)
    // A template referenced a template the set does not hold. This is
    // the error a host can act on: it means "go and read this file, add
    // it, and render again", which is what `terarender.missing` is for.
    ErrorTemplateNotFound(name: Str)
    // `{% extends %}` cycles, or an include includes itself.
    ErrorCycle(name: Str)
    // A `{% block %}` name defined twice in one template.
    ErrorDuplicateBlock(name: Str)
    // A render bound in `TeraLimits` was reached.
    ErrorLimit(what: Str)

// TeraError is one failure, with everything needed to report it.
pub struct TeraError
    kind: TeraErrorKind
    // Where it happened.
    at: TeraSpan
    // How the renderer got there, innermost first.  Empty for an error
    // in the template the caller asked for directly.
    chain: [TeraFrame]

// What went wrong, in words, for a caller that logs rather than
// branches.
//
// `Result<_, TeraError>` requires it: SPEC § 3.4 admits a `Result`
// error type only if it implements `Error`, so this impl is what lets
// every function in the package name its own refusal instead of
// returning `Result<_, Str>`.
impl Error for TeraError
    fn message(self) -> Str
        kind_message(self.kind)

// report is the error as a caller should print it: the message, the
// position, the source line, a caret, and the chain.
//
// It takes the sources because the error does not hold them — an error
// value that carried a copy of every template it passed through would
// be an error value nobody wanted to keep.  `sources` is name-and-text
// pairs, which is what a `TeraSet` can hand over.
//
// ```novo ignore
// unknown variable `user.nmae` in `nav.html`, line 4
//   4 |   <a href="/u/{{ user.nmae }}">
//     |                  ^^^^^^^^^
//   included from `header.html`, line 12
//   included from `base.html`, line 3
//   in block `content` of `page.html`, line 8
// ```
pub fn report(e: TeraError, sources: [TeraSource]) -> Str []
    var out = e.message() + " in `" + e.at.template + "`, line " + str.from_int(e.at.line)
    out = out + excerpt(e.at, sources)
    for f in e.chain
        out = out + "\n  " + frame_text(f)
    out

// TeraSource is a template's name and its text, for `report`.
pub struct TeraSource
    name: Str
    text: Str

// span_at is the position of a byte offset in a template's text: its
// line and column, both counted from 1.
//
// A function of its own because the parser and the renderer each know
// an offset where they find a fault and need the same arithmetic to
// turn it into the position an error reports.
pub fn span_at(template: Str, source: Str, offset: Int) -> TeraSpan []
    var line = 1
    var start = 0
    var i = 0
    let end = min_int(offset, str.len(source))
    while i < end
        if str.byte_at_or(source, i, 0) == '\n'
            line = line + 1
            start = i + 1
        i = i + 1
    TeraSpan { template: template, line: line, column: offset - start + 1, offset: offset }

fn min_int(a: Int, b: Int) -> Int
    if a < b
        return a
    b

// nearest is the name in `candidates` closest to `name`, or empty when
// none is within two edits.
//
// What an unknown filter's `suggestion` is made of: one inserted,
// dropped or changed letter is a typo, and a name further off than two
// is a different word.
pub fn nearest(name: Str, candidates: [Str]) -> Str []
    var best = ""
    var best_cost = 3
    for c in candidates
        let cost = edit_distance(name, c)
        if cost < best_cost
            best = c
            best_cost = cost
    best

// The fewest single-byte insertions, deletions and changes that turn
// `a` into `b`.
fn edit_distance(a: Str, b: Str) -> Int
    var row: [Int] = []
    for j in 0..str.len(b) + 1
        list.push(row, j)
    for i in 0..str.len(a)
        var next: [Int] = [i + 1]
        for j in 0..str.len(b)
            var cost = 1
            if str.byte_at_or(a, i, 0) == str.byte_at_or(b, j, 0)
                cost = 0
            list.push(next, min_int(min_int(row[j + 1] + 1, next[j] + 1), row[j] + cost))
        row = next
    row[str.len(b)]

// one_line is the error without the source excerpt.
//
// For a log, where the caret is noise: `nav.html:4:18: unknown
// variable `user.nmae``.
pub fn one_line(e: TeraError) -> Str []
    e.at.template + ":" + str.from_int(e.at.line) + ":" + str.from_int(e.at.column) + ": " + e.message()

// missing_template is the name a `ErrorTemplateNotFound` names, or
// `None` for any other error.
//
// The one question a host asks of an error without looking at it: is
// this something I can fix by reading a file.  A function rather than
// a match at every call site, because the render loop that asks it is
// the shape this whole package is built around.
pub fn missing_template(e: TeraError) -> ?Str []
    match e.kind
        ErrorTemplateNotFound(name) =>
            Some(name)
        _                           =>
            None

// The error's kind in words.
fn kind_message(k: TeraErrorKind) -> Str
    match k
        ErrorSyntax(found)              =>
            "syntax error at `" + found + "`"
        ErrorUnclosed(tag)              =>
            "`" + tag + "` is never closed"
        ErrorUnexpectedTag(tag)         =>
            "unexpected `" + tag + "`"
        ErrorUnknownVariable(name)      =>
            "unknown variable `" + name + "`"
        ErrorNoSuchField(path)          =>
            "no such field `" + path + "`"
        ErrorUnknownFilter(name, hint)  =>
            unknown_filter(name, hint)
        ErrorFilterRefused(filter, why) =>
            "filter `" + filter + "` wanted " + why
        ErrorTemplateNotFound(name)     =>
            "template `" + name + "` is not in the set"
        ErrorCycle(name)                =>
            "`" + name + "` includes or extends itself"
        ErrorDuplicateBlock(name)       =>
            "block `" + name + "` is defined twice"
        ErrorLimit(what)                =>
            "the " + what + " limit was reached"

fn unknown_filter(name: Str, hint: Str) -> Str
    let base = "unknown filter or test `" + name + "`"
    if hint == ""
        return base
    base + ", did you mean `" + hint + "`"

// One chain entry as a line of the report.
fn frame_text(f: TeraFrame) -> Str
    let where = "`" + f.at.template + "`, line " + str.from_int(f.at.line)
    match f.how
        FrameInclude  =>
            "included from " + where
        FrameExtends  =>
            "extended from " + where
        FrameBlock(n) =>
            "in block `" + n + "` of " + where
        FrameMacro(n) =>
            "in macro `" + n + "`, called from " + where

// The source line of a span with a caret under the text, or nothing
// when the source is not among `sources`.
fn excerpt(at: TeraSpan, sources: [TeraSource]) -> Str
    for src in sources
        if src.name == at.template
            let lines = str.split(src.text, "\n")
            if at.line < 1 or at.line > list.len(lines)
                return ""
            let text = lines[at.line - 1]
            let num = str.from_int(at.line)
            let gutter = str.repeat(" ", str.len(num))
            let pad = str.repeat(" ", at.column - 1)
            let width = word_width(text, at.column - 1)
            return "\n  " + num + " | " + text + "\n  " + gutter + " | " + pad + str.repeat("^", width)
    ""

// How many bytes of a name or path start at `from`; 1 for anything else.
fn word_width(text: Str, from: Int) -> Int
    var n = 0
    while is_word(str.byte_at_or(text, from + n, 0))
        n = n + 1
    if n == 0
        return 1
    n

fn is_word(b: Int) -> Bool
    b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b >= '0' and b <= '9' or b == '_' or b == '.'
